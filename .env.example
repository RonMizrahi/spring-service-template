# Copy to .env and adjust. docker-compose reads these automatically.

# Active Spring profile for the container (dev | stg | prod). Compose defaults to stg.
SPRING_PROFILES_ACTIVE=stg

# JWT signing secret (min 32 chars). REQUIRED in stg/prod — the app fails fast without it.
JWT_SECRET=local-docker-only-secret-change-me-min-32-characters

# PostgreSQL
POSTGRES_DB=springdb
POSTGRES_USER=spring
POSTGRES_PASSWORD=spring123
